import Foundation

/// The Google Cloud API key baked into this build. Copy this file to
/// `DefaultAPIKeys.swift` (gitignored — never commit your real key) and fill
/// it in; there is no Settings UI to enter one at runtime.
///
/// Baking a key into the binary means anyone who extracts this app (from a
/// device backup, an .ipa, a decompile) can read it out and run up charges
/// on your account. Only do this for a personal build you won't distribute.
enum DefaultAPIKeys {
    static let google: String? = nil
}
